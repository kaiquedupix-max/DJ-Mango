# Token do único bot público DJ Mango.
DISCORD_TOKEN=

# Backend de busca de músicas.
# soundcloud evita a exigência de login/anti-bot do YouTube em IPs de datacenter.
# Use youtube apenas se quiser voltar ao comportamento antigo.
MUSIC_BACKEND=soundcloud

# Opcional: caminho para um arquivo Netscape de cookies dentro do container.
# Só é usado quando MUSIC_BACKEND=youtube.
YTDLP_COOKIES_FILE=

# Opcional no Coolify: conteúdo do cookies.txt codificado em Base64.
# Só é usado quando MUSIC_BACKEND=youtube.
YTDLP_COOKIES_B64=

# Volume inicial, de 0 a 100.
DEFAULT_VOLUME=50

# Segundos sem música antes de sair da call.
IDLE_TIMEOUT=120

# Quantos segundos antes do fim começar a preparar a próxima faixa.
AUTOPLAY_PREFETCH_SECONDS=35

# Cache temporário. O bot apaga os arquivos após tocar e limpa sobras ao reiniciar.
MUSIC_CACHE_DIR=/tmp/dj-mango-cache

# INFO, DEBUG, WARNING...
LOG_LEVEL=INFO
