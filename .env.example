# Bot principal: recebe os slash commands e também pode tocar em 1 call por servidor.
DISCORD_TOKEN=

# Bots auxiliares: 1 token extra = +1 call simultânea por servidor.
# Separe os tokens por vírgula, ponto e vírgula ou quebra de linha.
DISCORD_WORKER_TOKENS=

# Opcional: use somente durante testes para sincronizar slash commands instantaneamente em 1 servidor.
# Em produção pública no Coolify, deixe vazio para usar comandos globais.
DISCORD_GUILD_ID=

# Opcional: cookies Netscape para vídeos que exijam autenticação.
YTDLP_COOKIES_FILE=

# Volume inicial, 0 a 100.
DEFAULT_VOLUME=50

# Segundos sem música antes de liberar o bot da call.
IDLE_TIMEOUT=120

LOG_LEVEL=INFO
