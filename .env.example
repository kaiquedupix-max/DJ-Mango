# Token do único bot público DJ Mango.
DISCORD_TOKEN=

# Opcional: cookies Netscape para vídeos que exijam autenticação no YouTube.
YTDLP_COOKIES_FILE=

# Volume inicial, de 0 a 100.
DEFAULT_VOLUME=50

# Segundos sem música antes de sair da call.
IDLE_TIMEOUT=120

# INFO, DEBUG, WARNING...
LOG_LEVEL=INFO
